{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cook.local/schema/recipe.schema.json",
  "title": "Recipe",
  "$defs": {
    "i18nText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "ca": { "type": "string" },
            "es": { "type": "string" }
          },
          "required": ["en"],
          "additionalProperties": false
        }
      ]
    },
    "base": {
      "type": "object",
      "required": ["title", "description", "image", "categories", "portion", "ingredients"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "author": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "development": { "type": "boolean" },
        "defaultVariant": { "type": "string" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "name"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "name": { "$ref": "#/$defs/i18nText" }
            },
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "$ref": "#/$defs/i18nText" }
            },
            "additionalProperties": false
          }
        },
        "portion": {
          "type": "object",
          "oneOf": [
            {
              "properties": {
                "type": { "const": "servings" },
                "value": { "type": "number", "exclusiveMinimum": 0 },
                "unit": { "type": "string", "minLength": 1 }
              },
              "required": ["type", "value", "unit"],
              "additionalProperties": false
            },
            {
              "properties": {
                "type": { "const": "units" },
                "value": { "type": "number", "exclusiveMinimum": 0 },
                "unit": { "type": "string", "minLength": 1 }
              },
              "required": ["type", "value", "unit"],
              "additionalProperties": false
            },
            {
              "properties": {
                "type": { "const": "area" },
                "shape": { "enum": ["circular", "rectangular", "square"] },
                "dimensions": { "type": "object" }
              },
              "required": ["type", "shape", "dimensions"],
              "additionalProperties": false
            }
          ]
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "amount", "unit", "item"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "amount": { "type": "number", "minimum": 0 },
              "unit": { "type": "string", "minLength": 1 },
              "item": { "$ref": "#/$defs/i18nText" },
              "note": { "$ref": "#/$defs/i18nText" },
              "group": { "$ref": "#/$defs/i18nText" },
              "onlyForVariation": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "translation": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/base" },
    { "$ref": "#/$defs/translation" }
  ]
}
